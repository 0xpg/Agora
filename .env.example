# Base Sepolia RPC — get one from a provider (Alchemy, Base's own public RPC, etc.)
RPC_URL=https://sepolia.base.org

# Deployer private key (testnet only — never commit a real key)
PRIVATE_KEY=

# EAS predeploy address for the target chain. Verify at docs.base.org before
# deploying — do not trust a value copied from elsewhere without checking.
EAS_ADDRESS=

# Settlement token (e.g. native USDC on Base Sepolia). Verify at circle.com's
# developer docs before deploying.
SETTLEMENT_TOKEN=

BASESCAN_API_KEY=
